# 可提交的普通运行配置。更新代码后，重新创建容器即可使用仓库中的新值。
# API Key、Token 和管理员 QQ 等部署私密配置保存在未跟踪的 .env 中。

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 所有DeepSeek调用（聊天、看图、入库及收藏审核）开启低强度思考
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_THINKING_MAX_TOKENS=4096

BOT_NAME=小群友
CHAT_PREFIX=/问
EVALUATE_PREFIX=/锐评
MIMIC_PREFIX=/模仿

AI_COOLDOWN_SECONDS=8
# 群话题、私聊和模仿共用并发；群话题有界排队，私聊/模仿满额提示重试
AI_MAX_CONCURRENCY=3
# ReAct Agent的模型轮数、工具调用数和整轮超时，防止无限循环
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=120
# 近期历史（群内包含机器人回复）；单条历史最多1000字，总量另设上限
CONTEXT_MESSAGE_LIMIT=80
CONTEXT_MAX_CHARS=24000
# 群成员长期记忆和本地混合RAG；自动写入仅接受当前消息中明确、稳定、非敏感的信息
MEMORY_ENABLED=true
MEMORY_AUTO_CAPTURE_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_CANDIDATE_LIMIT=300
MEMORY_USER_HISTORY_LIMIT=12
MEMORY_MAX_PER_USER=200
MEMORY_MAX_CHARS=200
MEMORY_MIN_CONFIDENCE=0.8
# 本地BGE ONNX模型缺失或推理失败时自动退回原有哈希检索
EMBEDDING_PROVIDER=bge_onnx
EMBEDDING_MODEL_PATH=/app/models/bge-small-zh-v1.5
EMBEDDING_MODEL_FILE=model_quantized.onnx
EMBEDDING_MAX_LENGTH=128
EMBEDDING_THREADS=2
EMBEDDING_BACKFILL_BATCH_SIZE=16
EMBEDDING_MIN_SIMILARITY=0.35
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# @或聊天命令唤醒群话题，固定3秒聚批；运行中消息进入有界下一批
CHAT_BATCH_SECONDS=3
CHAT_BATCH_MAX_MESSAGES=30
CHAT_MAX_PENDING_GROUPS=32
CHAT_QUEUE_WAIT_SECONDS=120
# wait_for_messages维持话题；finish退回低活跃度；沉默不刷新寿命
CHAT_ACTIVE_IDLE_SECONDS=180
CHAT_ACTIVE_MAX_SECONDS=900
GROUP_REPLY_MAX_CHARS=100

# 一次性私聊提醒的检查间隔（秒）和每位用户未完成提醒的上限
REMINDER_POLL_SECONDS=5
REMINDER_MAX_PENDING=50

# 私聊、群聊@及/问、/锐评的当前附图，LLM按需调用工具才上传；单图最多5MiB
CHAT_IMAGE_ENABLED=true
CHAT_IMAGE_MAX_BYTES=5242880

# 本地表情包目录，Docker会固定为/app/app/sticker_images；图片最大5MiB
STICKER_ENABLED=true
# 按需查看本地表情原图，要求所选模型支持视觉；每轮最多看3张不同图片
STICKER_VISION_ENABLED=true
# 新图片在后台调用视觉模型自动标注，结果缓存到SQLite；会产生API费用
STICKER_AUTO_INDEX_ENABLED=true
STICKER_INDEX_POLL_SECONDS=60
STICKER_INDEX_BATCH_SIZE=5
STICKER_INDEX_RETRY_SECONDS=3600
STICKER_PREVIEW_LIMIT=3
# 每轮提供可发送表情的文字目录：一半常用/相关，一半按小时轮换；0关闭目录预览
STICKER_PROMPT_LIMIT=10
STICKER_PROMPT_ROTATE_SECONDS=3600
STICKER_DIRECTORY=app/sticker_images
# 收藏只通过LLM工具触发，来源限当前群图片；独立审核后写入数据卷
STICKER_COLLECT_ENABLED=true
# 收藏由当前聚批Agent决定；低活跃期不另起图片观察或发收藏确认
STICKER_COLLECTED_DIRECTORY=data/collected_stickers
STICKER_COLLECT_COOLDOWN_SECONDS=60
STICKER_COLLECT_MAX_FILES=200
STICKER_COLLECT_MAX_DISK_BYTES=209715200
STICKER_COOLDOWN_SECONDS=10
STICKER_REPEAT_SECONDS=7200
STICKER_MAX_BYTES=5242880

STYLE_SAMPLE_LIMIT=60
MESSAGE_RETENTION_DAYS=30
