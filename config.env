# 可提交的普通运行配置。更新代码后，重新创建容器即可使用仓库中的新值。
# API Key、Token 和管理员 QQ 等部署私密配置保存在未跟踪的 .env 中。

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

BOT_NAME=小群友
CHAT_PREFIX=/问
EVALUATE_PREFIX=/锐评
MIMIC_PREFIX=/模仿

AI_COOLDOWN_SECONDS=8
# 群聊和私聊共用的后台 AI 并发上限，满额时提示稍后重试
AI_MAX_CONCURRENCY=3
# 不含当前问题的历史消息条数；条数越多，模型输入和费用可能越大
CONTEXT_MESSAGE_LIMIT=40

# 至少 3 位不同群友在最近 180 秒内发普通文字，机器人可自动接话
AUTO_CHAT_ENABLED=true
AUTO_CHAT_MIN_USERS=3
AUTO_CHAT_WINDOW_SECONDS=180
# 每群一次自动尝试结束后的冷却；失败或决定不插话也计入
AUTO_CHAT_COOLDOWN_SECONDS=30

# 一次性私聊提醒的检查间隔（秒）和每位用户未完成提醒的上限
REMINDER_POLL_SECONDS=5
REMINDER_MAX_PENDING=50

# 本地表情包目录，Docker会固定为/app/app/sticker_images；图片最大5MiB
STICKER_ENABLED=true
STICKER_DIRECTORY=app/sticker_images
STICKER_COOLDOWN_SECONDS=30
STICKER_REPEAT_SECONDS=7200
STICKER_MAX_BYTES=5242880

STYLE_SAMPLE_LIMIT=60
MESSAGE_RETENTION_DAYS=30
