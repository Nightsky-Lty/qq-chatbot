# 可提交的普通运行配置。更新代码后，重新创建容器即可使用仓库中的新值。
# API Key、Token 和管理员 QQ 等部署私密配置保存在未跟踪的 .env 中。

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 聊天和聊天看图开启high强度思考，后台标记/记忆的思考开关独立配置
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING_MAX_TOKENS=4096

BOT_NAME=小群友
SERVER_STATUS_PROC_PATH=/host/proc
CHAT_PREFIX=/问
EVALUATE_PREFIX=/锐评
MIMIC_PREFIX=/模仿

AI_COOLDOWN_SECONDS=8
# 私聊单独计冷却，不影响群聊批次间隔或模仿
PRIVATE_AI_COOLDOWN_SECONDS=1
# 群话题、私聊和模仿共用并发；群聊/私聊有界排队，模仿满额提示重试
AI_MAX_CONCURRENCY=3
# ReAct Agent的模型轮数、工具调用数和整轮超时，防止无限循环
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT_SECONDS=120
# 最后一次发送可携带next_action，成功回执后直接等待/结束，省掉单独收尾模型调用
AGENT_BATCH_COMPLETION_ENABLED=true
# 基础发送/收尾工具常驻，复用本地embedding按语义检索其他工具；关闭恢复全量工具。
TOOL_SEARCH_ENABLED=true
TOOL_SEARCH_MAX_CALLS=3
TOOL_SEARCH_TOP_K=3
TOOL_SEARCH_MIN_SIMILARITY=0.35
# DeepSeek官方Search/Fetch API，复用DEEPSEEK_API_KEY；不再抓取Bing网页
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_CALLS=2
WEB_SEARCH_NEED_CONTENT=true
# 每页最多6000字，单次搜索展开正文总量最多12000字；其余正文在本轮缓存
WEB_SEARCH_CONTENT_MAX_CHARS=12000
# 仅计算额外Fetch API调用，搜索自带正文/缓存命中不计；失败也计本地次数
WEB_FETCH_MAX_CALLS=4
WEB_TIMEOUT_SECONDS=30
WEB_MAX_RESPONSE_BYTES=1048576
WEB_FETCH_MAX_CHARS=6000
# 工作记忆默认取最近30条连续原文，受字符上限约束
CONTEXT_MESSAGE_LIMIT=30
CONTEXT_MAX_CHARS=24000
# 对话短期记忆：原文窗口，不做LLM摘要；TTL仅控制内存会话缓存
WORKING_MEMORY_ENABLED=true
WORKING_MEMORY_TTL_SECONDS=1800
WORKING_MEMORY_MAX_SCOPES=64
WORKING_MEMORY_MAX_MESSAGES=128
WORKING_MEMORY_CONTEXT_MAX_CHARS=24000
# 当前群/私聊更早原文翻页；无额外解析模型。
CHAT_HISTORY_READ_MAX_CALLS=3
CHAT_HISTORY_READ_MAX_CHARS=12000
CHAT_HISTORY_READ_TOTAL_CHARS=24000
# 群成员长期记忆和本地混合RAG；自动写入仅接受当前消息中明确、稳定、非敏感的信息
MEMORY_ENABLED=true
MEMORY_AUTO_CAPTURE_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_CANDIDATE_LIMIT=300
MEMORY_USER_HISTORY_LIMIT=12
MEMORY_MAX_PER_USER=200
MEMORY_MAX_CHARS=200
MEMORY_MIN_CONFIDENCE=0.8
# 后台记忆提取独立调用，默认30秒合并一批；任务及游标持久保存
MEMORY_CAPTURE_DELAY_SECONDS=30
MEMORY_CAPTURE_BATCH_SIZE=40
MEMORY_CAPTURE_RETRY_SECONDS=60
# SQLite权威记录；Qdrant仅作可重建索引，不可用时自动本地降级。
MEMORY_QDRANT_URL=http://qdrant:6333
MEMORY_QDRANT_COLLECTION=qq_memory
MEMORY_QDRANT_TIMEOUT_SECONDS=3
MEMORY_SEARCH_ROUTE_LIMIT=20
MEMORY_CONTEXT_MAX_CHARS=5000
MEMORY_SOURCE_SEARCH_ENABLED=true
# 含糊追问用本轮已核验的直接往返补充自动记忆检索，不改变工具查询。
MEMORY_CONTEXT_QUERY_ENABLED=true
# 默认仅在模型主动使用memory_search时检索，后台记忆整理仍工作。
MEMORY_AUTO_RECALL_ENABLED=false
MEMORY_JOB_MAX_ATTEMPTS=5
IMAGE_MEMORY_RETENTION_DAYS=90
# 留空复用聊天模型/地址；凭证在.env，后台默认不开思考以降低延迟和费用
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_THINKING_ENABLED=false
IMAGE_LLM_MODEL=
IMAGE_LLM_BASE_URL=
IMAGE_LLM_THINKING_ENABLED=false
IMAGE_CACHE_ENABLED=true
IMAGE_CACHE_RETENTION_DAYS=7
IMAGE_CACHE_MAX_FILES=500
IMAGE_CACHE_MAX_BYTES=268435456
IMAGE_CACHE_QUEUE_LIMIT=200
IMAGE_CACHE_CONTEXT_LIMIT=12
STICKER_LLM_MODEL=
STICKER_LLM_BASE_URL=
STICKER_LLM_THINKING_ENABLED=false
# 本地BGE ONNX模型缺失或推理失败时自动退回原有哈希检索
EMBEDDING_PROVIDER=bge_onnx
EMBEDDING_MODEL_PATH=/app/models/bge-small-zh-v1.5
EMBEDDING_MODEL_FILE=model_quantized.onnx
EMBEDDING_MAX_LENGTH=128
EMBEDDING_THREADS=2
EMBEDDING_BACKFILL_BATCH_SIZE=16
EMBEDDING_MIN_SIMILARITY=0.35
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# @或聊天命令唤醒群话题，固定3秒聚批；运行中消息进入有界下一批
CHAT_BATCH_SECONDS=3
CHAT_BATCH_MAX_MESSAGES=30
CHAT_MAX_PENDING_GROUPS=32
CHAT_QUEUE_WAIT_SECONDS=120
# wait_for_messages维持活跃跟进；群内连续3分钟无人发言由程序退出
CHAT_ACTIVE_IDLE_SECONDS=180
CHAT_ACTIVE_MAX_SECONDS=1800
# 普通聊天每条1～20字符；完整网址/代码单独一条，可超长；整轮默认最多6条
GROUP_REPLY_MAX_CHARS=20
CHAT_REPLY_MAX_MESSAGES=6
# LLM按需调用主动戳一戳，每轮最多一次，同一群/私聊冷却60秒
POKE_ENABLED=true
POKE_COOLDOWN_SECONDS=60
# 群聊QQ AI语音，由NapCat合成并发送；空音色默认使用接口真实列表第一项
VOICE_ENABLED=true
VOICE_CHARACTER_ID=
VOICE_MAX_CHARS=100
VOICE_COOLDOWN_SECONDS=60
# 保留按活跃人数随机唤醒机制，三项概率暂设0以暂停主动插话；不影响@唤醒后的跟进
RANDOM_CHAT_ENABLED=true
RANDOM_CHAT_WINDOW_SECONDS=120
RANDOM_CHAT_MIN_PROBABILITY=0
RANDOM_CHAT_PROBABILITY_PER_USER=0
RANDOM_CHAT_MAX_PROBABILITY=0
RANDOM_CHAT_COOLDOWN_SECONDS=60

# 一次性私聊提醒的检查间隔（秒）和每位用户未完成提醒的上限
REMINDER_POLL_SECONDS=5
REMINDER_MAX_PENDING=50

# 私聊、群聊@及/问、/锐评的当前附图，LLM按需调用工具才上传；单图最多5MiB
CHAT_IMAGE_ENABLED=true
CHAT_IMAGE_MAX_BYTES=5242880

# 本地表情包目录，Docker会固定为/app/app/sticker_images；图片最大5MiB
STICKER_ENABLED=true
# 按成功回复轮数提醒发表情；false恢复完全由模型自主决定，表情工具始终保留。
STICKER_REPLY_CADENCE_ENABLED=true
STICKER_REPLY_MIN_ROUNDS=5
STICKER_REPLY_MAX_ROUNDS=7
# 按需查看本地表情原图，要求所选模型支持视觉；每轮最多看3张不同图片
STICKER_VISION_ENABLED=true
# 新图片在后台调用视觉模型自动标注，结果缓存到SQLite；会产生API费用
STICKER_AUTO_INDEX_ENABLED=true
STICKER_INDEX_POLL_SECONDS=60
STICKER_INDEX_BATCH_SIZE=5
STICKER_INDEX_RETRY_SECONDS=3600
STICKER_PREVIEW_LIMIT=3
# 每轮提供可发送表情的文字目录：一半常用/相关，一半按小时轮换；0关闭目录预览
STICKER_PROMPT_LIMIT=10
STICKER_PROMPT_ROTATE_SECONDS=3600
STICKER_DIRECTORY=app/sticker_images
# 群聊/私聊收藏工具与群聊概率收图共用去重、视觉审核和分会话冷却；私聊不随机收图
STICKER_COLLECT_ENABLED=true
STICKER_COLLECT_PROBABILITY=0.20
STICKER_COLLECT_QUEUE_SIZE=32
STICKER_COLLECT_QUEUE_WAIT_SECONDS=120
STICKER_COLLECTED_DIRECTORY=data/collected_stickers
# 每群两次非重复图片审核之间至少60秒，避免连续审核失败也消耗大量API
STICKER_COLLECT_COOLDOWN_SECONDS=60
STICKER_COLLECT_MAX_FILES=200
STICKER_COLLECT_MAX_DISK_BYTES=209715200
STICKER_COOLDOWN_SECONDS=10
STICKER_REPEAT_SECONDS=7200
STICKER_MAX_BYTES=5242880

STYLE_SAMPLE_LIMIT=60
MESSAGE_RETENTION_DAYS=30
