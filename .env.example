# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# NapCat OneBot 11 与本服务需填写相同 token；生产环境务必修改
ONEBOT_ACCESS_TOKEN=change-me

# 云端 NapCat 管理页面登录密码，与 OneBot Token 分开设置
NAPCAT_WEBUI_TOKEN=change-me-too
# 首次部署使用当前镜像；运行稳定后可改成明确的版本标签
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# 逗号分隔的机器人管理员 QQ 号。群主和群管理员也有管理权限。
ADMIN_QQ_IDS=123456789

DATABASE_PATH=data/bot.db
BOT_NAME=小群友
CHAT_PREFIX=/问
EVALUATE_PREFIX=/锐评
MIMIC_PREFIX=/模仿
AI_COOLDOWN_SECONDS=8
CONTEXT_MESSAGE_LIMIT=20
STYLE_SAMPLE_LIMIT=60
MESSAGE_RETENTION_DAYS=30
