# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# NapCat OneBot 11 与本服务需填写相同 token；生产环境务必修改
ONEBOT_ACCESS_TOKEN=change-me

# 云端 NapCat 管理页面登录密码，与 OneBot Token 分开设置
NAPCAT_WEBUI_TOKEN=change-me-too
# 首次部署使用当前镜像；运行稳定后可改成明确的版本标签
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# 逗号分隔的机器人管理员 QQ 号。群主和群管理员也有管理权限。
ADMIN_QQ_IDS=123456789

DATABASE_PATH=data/bot.db
BOT_NAME=小群友
CHAT_PREFIX=/问
EVALUATE_PREFIX=/锐评
MIMIC_PREFIX=/模仿
AI_COOLDOWN_SECONDS=8
# 群聊和私聊共用的后台 AI 并发上限，满额时提示稍后重试
AI_MAX_CONCURRENCY=3
# 不含当前问题的历史消息条数；条数越多，模型输入和费用可能越大
CONTEXT_MESSAGE_LIMIT=40
# 至少 3 位不同群友在最近 180 秒内发普通文字，机器人可自动接话
AUTO_CHAT_ENABLED=true
AUTO_CHAT_MIN_USERS=3
AUTO_CHAT_WINDOW_SECONDS=180
# 每群一次自动尝试结束后的冷却；失败或决定不插话也计入，避免连续请求
AUTO_CHAT_COOLDOWN_SECONDS=30
STYLE_SAMPLE_LIMIT=60
MESSAGE_RETENTION_DAYS=30
