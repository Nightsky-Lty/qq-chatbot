# 本文件只保存每个部署独有或敏感的值；普通配置统一在 config.env 中维护。
# 复制为 .env 后填写真实值，.env 已被 Git 忽略。

# Docker构建Python依赖的包索引；国内服务器可保留默认镜像，需要官方源时改为https://pypi.org/simple
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple

# DeepSeek API Key（必填）；聊天及官方Search/Fetch API复用此Key，搜索/抓取另按次计费
DEEPSEEK_API_KEY=sk-your-key

# 独立后台LLM凭证；留空继承DEEPSEEK_API_KEY，普通模型/地址配置放config.env
STICKER_LLM_API_KEY=
MEMORY_LLM_API_KEY=
# 可选：Qdrant内网认证；留空不鉴权，但Compose不会发布数据库端口。
MEMORY_QDRANT_API_KEY=
# 可选覆盖Qdrant镜像为可信镜像站的同版本镜像。
QDRANT_IMAGE=qdrant/qdrant:v1.19.2
IMAGE_LLM_API_KEY=

# NapCat OneBot 11 与本服务需填写相同 token；生产环境务必修改
ONEBOT_ACCESS_TOKEN=change-me

# 云端 NapCat 管理页面登录密码，与 OneBot Token 分开设置
NAPCAT_WEBUI_TOKEN=change-me-too

# 逗号分隔的机器人管理员 QQ 号。群主和群管理员也有管理权限。
ADMIN_QQ_IDS=123456789
